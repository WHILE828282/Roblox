        "$className": "Sky",
        "$properties": {
          "SunAngularSize": 14,
          "MoonAngularSize": 9,
          "StarCount": 2500
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.7,
          "Size": 30,
          "Threshold": 1.1
