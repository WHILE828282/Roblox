    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Brightness": 2.6,
        "ClockTime": 16.4,
        "GeographicLatitude": 28,
        "Ambient": [
          0.27,
          0.24,
          0.3
        ],
        "OutdoorAmbient": [
          0.5,
          0.47,
          0.5
