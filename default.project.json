        "$properties": {
          "Intensity": 0.12,
          "Spread": 0.7
        }
      },
      "DepthOfField": {
        "$className": "DepthOfFieldEffect",
        "$properties": {
          "FarIntensity": 0.18,
          "FocusDistance": 120,
          "InFocusRadius": 260,
          "NearIntensity": 0
        }
      }
